//
// cvt_precision.ptx -- numeric type conversions and rounding
//
// Target: PTX ISA 8.3, sm_90
// Assemble (requires the CUDA toolkit): ptxas -arch=sm_90 cvt_precision.ptx
// Reference: PTX ISA documentation, https://docs.nvidia.com/cuda/parallel-thread-execution/
//
.version 8.3
.target sm_90
.address_size 64

.visible .entry cvt_kernel(
    .param .u64 out
)
{
    .reg .b32   %r<6>;
    .reg .b64   %rd<2>;
    .reg .f32   %f<4>;
    .reg .f64   %d<2>;

    ld.param.u64    %rd1, [out];
    mov.u32         %r1, 12345;
    cvt.rn.f32.u32      %f1, %r1;
    cvt.rzi.s32.f32     %r2, %f1;
    cvt.f64.f32         %d1, %f1;
    cvt.rn.f32.f64      %f2, %d1;
    cvt.u8.u32          %r3, %r1;
    cvt.u16.u32         %r4, %r1;

    st.global.f32   [%rd1], %f2;
    add.s64         %rd2, %rd1, 4;
    st.global.u32   [%rd2], %r4;
    ret;
}
