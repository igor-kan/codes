//
// integer_ops.ptx -- integer arithmetic, shifts and bitwise ops
//
// Target: PTX ISA 8.3, sm_90
// Assemble (requires the CUDA toolkit): ptxas -arch=sm_90 integer_ops.ptx
// Reference: PTX ISA documentation, https://docs.nvidia.com/cuda/parallel-thread-execution/
//
.version 8.3
.target sm_90
.address_size 64

.visible .entry integer_ops(
    .param .u64 out
)
{
    .reg .b32   %r<12>;
    .reg .b64   %rd<4>;

    ld.param.u64    %rd1, [out];
    mov.u32         %r1, 7;
    mov.u32         %r2, 3;

    mul.lo.u32      %r3, %r1, %r2;          // 21
    mad.lo.u32      %r4, %r1, %r2, %r1;     // 28
    mul.hi.u32      %r5, %r1, %r2;          // high word
    div.u32         %r6, %r1, %r2;          // 2
    rem.u32         %r7, %r1, %r2;          // 1
    shl.b32         %r8, %r1, 2;            // 28
    shr.u32         %r9, %r1, 1;            // 3
    and.b32         %r10, %r1, %r2;         // 3
    or.b32          %r11, %r1, %r2;         // 7

    st.global.v4.u32    [%rd1], {%r3, %r4, %r5, %r6};
    add.s64         %rd2, %rd1, 16;
    st.global.v4.u32    [%rd2], {%r7, %r8, %r9, %r10};
    ret;
}
