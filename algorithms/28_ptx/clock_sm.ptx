//
// clock_sm.ptx -- SM clock and special register reads
//
// Target: PTX ISA 8.3, sm_90
// Assemble (requires the CUDA toolkit): ptxas -arch=sm_90 clock_sm.ptx
// Reference: PTX ISA documentation, https://docs.nvidia.com/cuda/parallel-thread-execution/
//
.version 8.3
.target sm_90
.address_size 64

.visible .entry clock_kernel(
    .param .u64 out
)
{
    .reg .b32   %r<6>;
    .reg .b64   %rd<4>;

    ld.param.u64    %rd1, [out];
    mov.u32         %r1, %clock;            // per-SM clock
    mov.u32         %r2, %smid;             // SM id
    mov.u32         %r3, %warpid;
    mov.u64         %rd2, %globaltimer;
    st.global.u32   [%rd1], %r1;
    add.s64         %rd3, %rd1, 4;
    st.global.u32   [%rd3], %r2;
    ret;
}
