//
// grid_stride.ptx -- grid-stride loop over an array
//
// Target: PTX ISA 8.3, sm_90
// Assemble (requires the CUDA toolkit): ptxas -arch=sm_90 grid_stride.ptx
// Reference: PTX ISA documentation, https://docs.nvidia.com/cuda/parallel-thread-execution/
//
.version 8.3
.target sm_90
.address_size 64

.visible .entry grid_stride(
    .param .u64 data,
    .param .u32 n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<10>;
    .reg .b64   %rd<6>;
    .reg .f32   %f<4>;

    ld.param.u64    %rd1, [data];
    ld.param.u32    %r1, [n];

    mov.u32         %r2, %ctaid.x;
    mov.u32         %r3, %ntid.x;
    mov.u32         %r4, %tid.x;
    mad.lo.u32      %r5, %r2, %r3, %r4;     // thread id
    mov.u32         %r6, %nctaid.x;
    mul.lo.u32      %r7, %r6, %r3;          // grid stride

$L_loop:
    setp.ge.u32     %p1, %r5, %r1;
    @%p1 bra        $L_exit;
    mul.wide.u32    %rd2, %r5, 4;
    add.s64         %rd3, %rd1, %rd2;
    ld.global.f32   %f1, [%rd3];
    mul.f32         %f2, %f1, %f1;          // square
    st.global.f32   [%rd3], %f2;
    add.u32         %r5, %r5, %r7;
    bra             $L_loop;

$L_exit:
    ret;
}
