pipeline {
  agent any
  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment {
    REGISTRY = 'ghcr.io/example/app'
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Build') {
      steps { sh 'docker build -t $REGISTRY:$GIT_COMMIT .' }
    }
    stage('Test') {
      steps { sh 'docker run --rm $REGISTRY:$GIT_COMMIT npm test' }
      post {
        always { junit 'reports/**/*.xml' }
      }
    }
    stage('Deploy') {
      when { branch 'main' }
      steps { sh './devops/scripts/deploy.sh $GIT_COMMIT' }
    }
  }
  post {
    failure { slackSend channel: '#ci', message: "Build failed: ${env.BUILD_URL}" }
  }
}
