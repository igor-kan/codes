{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "tls": {
      "enabled": false,
      "certPath": "/etc/ssl/cert.pem"
    }
  },
  "database": {
    "driver": "postgres",
    "url": "postgres://localhost:5432/app",
    "pool": { "min": 2, "max": 10, "idleTimeoutMs": 30000 }
  },
  "logging": { "level": "info", "format": "json" },
  "features": ["search", "notifications"]
}
