//
// predicates.ptx -- predicated execution and setp
//
// Target: PTX ISA 8.3, sm_90
// Assemble (requires the CUDA toolkit): ptxas -arch=sm_90 predicates.ptx
// Reference: PTX ISA documentation, https://docs.nvidia.com/cuda/parallel-thread-execution/
//
.version 8.3
.target sm_90
.address_size 64

.visible .entry predicates(
    .param .u64 out,
    .param .u32 n
)
{
    .reg .pred  %p<4>;
    .reg .b32   %r<8>;
    .reg .b64   %rd<4>;

    ld.param.u64    %rd1, [out];
    ld.param.u32    %r1, [n];
    mov.u32         %r2, %tid.x;

    // signed and unsigned comparisons
    setp.lt.s32     %p1, %r2, %r1;
    setp.ge.u32     %p2, %r2, 0;
    setp.eq.b32     %p3, %r2, 0;
    and.pred        %p1, %p1, %p2;

    @%p1 mov.u32    %r3, 1;
    @!%p1 mov.u32   %r3, 0;

    mul.wide.u32    %rd2, %r2, 4;
    add.s64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r3;
    ret;
}
