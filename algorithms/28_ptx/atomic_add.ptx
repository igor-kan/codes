//
// atomic_add.ptx -- global atomic add counter
//
// Target: PTX ISA 8.3, sm_90
// Assemble (requires the CUDA toolkit): ptxas -arch=sm_90 atomic_add.ptx
// Reference: PTX ISA documentation, https://docs.nvidia.com/cuda/parallel-thread-execution/
//
.version 8.3
.target sm_90
.address_size 64

.visible .entry atomic_add(
    .param .u64 counter,
    .param .u32 n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<8>;
    .reg .b64   %rd<6>;

    ld.param.u64    %rd1, [counter];
    ld.param.u32    %r1, [n];
    mov.u32         %r2, %tid.x;
    setp.ge.u32     %p1, %r2, %r1;
    @%p1 bra        $L_exit;

    atom.global.add.u32     %r3, [%rd1], 1;
    atom.global.max.u32     %r4, [%rd1], 1000;
    red.global.add.u32      [%rd1], 1;

$L_exit:
    ret;
}
