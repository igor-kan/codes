//
// warp_vote.ptx -- warp-wide .vote ballot and any/all
//
// Target: PTX ISA 8.3, sm_90
// Assemble (requires the CUDA toolkit): ptxas -arch=sm_90 warp_vote.ptx
// Reference: PTX ISA documentation, https://docs.nvidia.com/cuda/parallel-thread-execution/
//
.version 8.3
.target sm_90
.address_size 64

.visible .entry warp_vote(
    .param .u64 out,
    .param .u32 n
)
{
    .reg .pred  %p<2>;
    .reg .b32   %r<8>;
    .reg .b64   %rd<6>;

    ld.param.u64    %rd1, [out];
    ld.param.u32    %r1, [n];
    mov.u32         %r2, %tid.x;

    setp.lt.u32     %p1, %r2, %r1;
    vote.ballot.sync.b32    %r3, %p1, 0xffffffff;
    vote.any.pred   %p2, %p1;
    @%p2 mov.u32    %r4, 1;

    mul.wide.u32    %rd2, %r2, 4;
    add.s64         %rd3, %rd1, %rd2;
    st.global.u32   [%rd3], %r3;
    ret;
}
